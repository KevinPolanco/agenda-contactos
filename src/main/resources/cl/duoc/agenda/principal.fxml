<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.agenda.PrincipalController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>


    <Label text="Nuevo contacto"
        style="-fx-font-size: 18px; -fx-font-wight: bold;" />

    <TextField fx:id="txtNombre" promptText="Nombre"/>
    <TextField fx:id="txtCorreo" promptText="Correo"/>
    <TextField fx:id="txtTelefono" promptText="Telefono"/>

    <HBox spacing="10">
        <Button text="Agregar" onAction="#onAgregar"/>
        <Button text="Limpiar" onAction="#onLimpiar"/>
    </HBox>

    <Label fx:id="lblMensaje"/>
</VBox>